class Car {
    private String model;

    Car(String model) {
        this.model = model;
    }

    void showModel() {
        System.out.println("Model: " + model);
    }
}

class Main {
    public static void main(String[] args) {
        Car c = new Car("BMW");

        // System.out.println(c.model);  // Error: model is private

        c.showModel();
    }
}
