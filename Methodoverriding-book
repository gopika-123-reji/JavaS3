class Book {
    String title;
    String author;

    Book(String title, String author) {
        this.title = title;
        this.author = author;
    }

    void display() {
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
    }
}

class TechnicalBook extends Book {
    String subject;

    TechnicalBook(String title, String author, String subject) {
        super(title, author);
        this.subject = subject;
    }

    void display() {
        System.out.println("Technical Book");
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
        System.out.println("Subject: " + subject);
    }
}

class StoryBook extends Book {
    String genre;

    StoryBook(String title, String author, String genre) {
        super(title, author);
        this.genre = genre;
    }

    void display() {
        System.out.println("Story Book");
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
        System.out.println("Genre: " + genre);
    }
}

class Main {
    public static void main(String[] args) {

        Book b;

        b = new Book("Java Basics", "James");
        b.display();

        System.out.println();

        b = new TechnicalBook("Java Programming", "Herbert", "Programming");
        b.display();

        System.out.println();

        b = new StoryBook("Harry Potter", "J.K. Rowling", "Fantasy");
        b.display();
    }
}
