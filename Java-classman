package pack1;

class Man {
    String name = "Smith";
    int age = 40;

    void displayMe() {
        System.out.println("Man's Name: " + name + ", Age: " + age);
    }
}

package pack2;

class Woman {
    String name = "Jane";
    int age = 35;

    void displayMe() {
        System.out.println("Woman's Name: " + name + ", Age: " + age);
    }
}

import pack1.Man;
import pack2.Woman;

public class Main {
    public static void main(String[] args) {
        Man m = new Man();
        Woman w = new Woman();

        m.displayMe();
        w.displayMe();
    }
}
